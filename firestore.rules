rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function userCompanyId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId;
    }

    
    
    // users
    match /users/{userId} {
      allow read: if request.auth != null 
                  && resource.data.companyId == userCompanyId();

      allow write: if request.auth != null 
                   && request.auth.uid == userId;
    }

    // tasks: read-only access to public tasks in the same company
    match /tasks/{taskId} {
      allow read: if request.auth != null
                   && resource.data.type == "public"
                   
    }
  }
}


//firebase deploy --only firestore:rules
