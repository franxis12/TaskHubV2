rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function userCompanyId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return userRole() == "admin";
    }

    function isApproved() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.pendingApproval == false;
    }

    function isValidTaskType(t) {
      return t == "public" || t == "personal";
    }

    function isAllowedStatus(s) {
      return s == "pending" || s == "progress" || s == "completed";
    }

    function companyExists(id) {
      return exists(/databases/$(database)/documents/companies/$(id));
    }

    // Block changing status when the task is already finalized (completed or missed)
    function statusChangeLocked() {
      return !((resource.data.status == "completed" || resource.data.status == "missed")
               && ("status" in request.resource.data)
               && request.resource.data.status != resource.data.status);
    }

    // Disallow any edit when task is in a terminal state (completed or missed)
    function isTerminal() {
      return resource.data.status == "completed" || resource.data.status == "missed";
    }

    // Require all subTasks to be "completed" if the task is being set to "completed"
    function subsAllCompletedForNewDoc() {
      return !(("subTasks" in request.resource.data) && request.resource.data.subTasks.size() > 0) ||
             (
               (request.resource.data.subTasks.size() > 0 && request.resource.data.subTasks[0].status == "completed") &&
               (request.resource.data.subTasks.size() > 1 && request.resource.data.subTasks[1].status == "completed" || request.resource.data.subTasks.size() <= 1) &&
               (request.resource.data.subTasks.size() > 2 && request.resource.data.subTasks[2].status == "completed" || request.resource.data.subTasks.size() <= 2) &&
               (request.resource.data.subTasks.size() > 3 && request.resource.data.subTasks[3].status == "completed" || request.resource.data.subTasks.size() <= 3) &&
               (request.resource.data.subTasks.size() > 4 && request.resource.data.subTasks[4].status == "completed" || request.resource.data.subTasks.size() <= 4) &&
               (request.resource.data.subTasks.size() > 5 && request.resource.data.subTasks[5].status == "completed" || request.resource.data.subTasks.size() <= 5) &&
               (request.resource.data.subTasks.size() > 6 && request.resource.data.subTasks[6].status == "completed" || request.resource.data.subTasks.size() <= 6) &&
               (request.resource.data.subTasks.size() > 7 && request.resource.data.subTasks[7].status == "completed" || request.resource.data.subTasks.size() <= 7) &&
               (request.resource.data.subTasks.size() > 8 && request.resource.data.subTasks[8].status == "completed" || request.resource.data.subTasks.size() <= 8) &&
               (request.resource.data.subTasks.size() > 9 && request.resource.data.subTasks[9].status == "completed" || request.resource.data.subTasks.size() <= 9)
             );
    }

    // Helper: checks if any subtask has status == "progress"
    // Helper: checks if any subtask has status == "progress"
    function hasProgressSubtask() {
      return ("subTasks" in resource.data)
             && (
               (resource.data.subTasks.size() > 0  && resource.data.subTasks[0].status  == "progress") ||
               (resource.data.subTasks.size() > 1  && resource.data.subTasks[1].status  == "progress") ||
               (resource.data.subTasks.size() > 2  && resource.data.subTasks[2].status  == "progress") ||
               (resource.data.subTasks.size() > 3  && resource.data.subTasks[3].status  == "progress") ||
               (resource.data.subTasks.size() > 4  && resource.data.subTasks[4].status  == "progress") ||
               (resource.data.subTasks.size() > 5  && resource.data.subTasks[5].status  == "progress") ||
               (resource.data.subTasks.size() > 6  && resource.data.subTasks[6].status  == "progress") ||
               (resource.data.subTasks.size() > 7  && resource.data.subTasks[7].status  == "progress") ||
               (resource.data.subTasks.size() > 8  && resource.data.subTasks[8].status  == "progress") ||
               (resource.data.subTasks.size() > 9  && resource.data.subTasks[9].status  == "progress")
             );
    }

    // users
    match /users/{userId} {
      // Read: you can always read your own doc; to see users from your company you must be approved
      allow read: if request.auth != null && (
                    userId == request.auth.uid ||
                    (isApproved() && resource.data.companyId == userCompanyId())
                  );

      // Update my own profile: allow basic fields + companyId + pendingApproval under rules below
      allow update: if request.auth != null
                     && request.auth.uid == userId
                     && request.resource.data.diff(resource.data).changedKeys().hasOnly([
                       "firstName", "lastName", "photo", "email", "companyId", "pendingApproval"
                     ])
                      && (
                        // If companyId changes: if it exists -> pendingApproval must be true; if it does NOT exist -> only admin and pendingApproval must be false
                        (
                          request.resource.data.companyId != resource.data.companyId && (
                            (companyExists(request.resource.data.companyId) && request.resource.data.pendingApproval == true) ||
                            (!companyExists(request.resource.data.companyId) && isAdmin() && request.resource.data.pendingApproval == false)
                          )
                        )
                        ||
                        // If companyId does NOT change: pendingApproval cannot change
                        (
                          request.resource.data.companyId == resource.data.companyId &&
                          request.resource.data.pendingApproval == resource.data.pendingApproval
                        )
                      );

      // Create my base doc (first login)
      allow create: if request.auth != null && request.auth.uid == userId;

      // Admin may update role/pendingApproval ONLY within their company
      allow update: if request.auth != null
                     && isAdmin()
                     && resource.data.companyId == userCompanyId()
                     && request.resource.data.companyId == resource.data.companyId
                     && request.resource.data.diff(resource.data).changedKeys().hasOnly([
                       "role", "pendingApproval"
                     ]);
    }

    // companies: allow GET for existence checks (registration + settings),
    // full read by approved users in their company; write restricted to company admin
    match /companies/{companyId} {
      // Allow GET for anyone (used to verify existence from UI flows)
      allow get: if true;
      // Full read for approved users in the same company
      allow read: if request.auth != null && isApproved() && companyId == userCompanyId();
      // Create/update by admin in the same company
      allow create: if request.auth != null
                     && isAdmin()
                     && companyId == userCompanyId()
                     && request.auth.uid == request.resource.data.createdBy;
      allow update: if request.auth != null
                     && isAdmin()
                     && companyId == userCompanyId()
                     && request.resource.data.createdBy == resource.data.createdBy
                     && request.resource.data.createdAt == resource.data.createdAt
                     && request.resource.data.diff(resource.data).changedKeys().hasOnly([
                       "logo", "theme"
                     ]);
    }
    match /companies/{companyId}/{document=**} {
      allow read: if request.auth != null && isApproved() && companyId == userCompanyId();
    }

    // tasks rules
    match /tasks/{taskId} {
      // Public tasks: readable by authenticated and approved users in the same company
      allow read: if request.auth != null
                   && isApproved()
                   && resource.data.type == "public"
                   && resource.data.companyId == userCompanyId();

      // Personal tasks: only the owner (createdBy) can read or write
      allow read: if request.auth != null
                   && resource.data.type == "personal"
                   && request.auth.uid == resource.data.createdBy;

      // Create personal task: owner must be requester; roles: admin or member; must be in my company; status cannot be "missed"
      allow create: if request.auth != null
                     && request.resource.data.type == "personal"
                     && isValidTaskType(request.resource.data.type)
                     && request.auth.uid == request.resource.data.createdBy
                     && request.resource.data.companyId == userCompanyId()
                     && (!("status" in request.resource.data) || isAllowedStatus(request.resource.data.status));

      // Create public task: admins only; creator == requester; must be in my company; status cannot be "missed"
      allow create: if request.auth != null
                     && request.resource.data.type == "public"
                     && isValidTaskType(request.resource.data.type)
                     && isAdmin()
                     && request.auth.uid == request.resource.data.createdBy
                     && request.resource.data.companyId == userCompanyId()
                     && (!("status" in request.resource.data) || isAllowedStatus(request.resource.data.status));

      // Update personal task: owner only; keep immutable fields; disallow any edit if it is completed or missed
      allow update: if request.auth != null
                     && resource.data.type == "personal"
                     && request.auth.uid == resource.data.createdBy
                     && request.resource.data.type == "personal"
                     && request.auth.uid == request.resource.data.createdBy
                     && resource.data.companyId == request.resource.data.companyId
                     && resource.data.createdBy == request.resource.data.createdBy
                     && resource.data.pendingCounted == request.resource.data.pendingCounted
                     && resource.data.completedCounted == request.resource.data.completedCounted
                     && resource.data.missedCounted == request.resource.data.missedCounted
                     && !isTerminal()
                     && (!("status" in request.resource.data) || request.resource.data.status != "completed" || subsAllCompletedForNewDoc())
                     && statusChangeLocked()
                     && (!("status" in request.resource.data) || isAllowedStatus(request.resource.data.status));

      // Delete personal task: owner only
      allow delete: if request.auth != null
                     && resource.data.type == "personal"
                     && request.auth.uid == resource.data.createdBy;

      // Public update by admin only if current status is not "progress"; limit to editable fields and keep immutable ones; block status change if already completed/missed; require all subTasks completed when completing
      allow update: if request.auth != null
                     && resource.data.type == "public"
                     && isAdmin()
                     && resource.data.status != "progress"
                     && !isTerminal()
                     && resource.data.type == request.resource.data.type
                     && resource.data.companyId == request.resource.data.companyId
                     && resource.data.createdBy == request.resource.data.createdBy
                     && resource.data.pendingCounted == request.resource.data.pendingCounted
                     && resource.data.completedCounted == request.resource.data.completedCounted
                     && resource.data.missedCounted == request.resource.data.missedCounted
                     && (!("status" in request.resource.data) || request.resource.data.status != "completed" || subsAllCompletedForNewDoc())
                     && statusChangeLocked()
                     && request.resource.data.diff(resource.data).changedKeys().hasOnly([
                          "taskName","notes","priority","completeBy","status","assignedTo","subTasks","completedAt"
                        ])
                     && (!("status" in request.resource.data) || isAllowedStatus(request.resource.data.status));

      // Assignee can change ONLY status (and completedAt) of a public task; do not allow status change if already completed or missed; require all subTasks completed when completing
      allow update: if request.auth != null
                     && resource.data.type == "public"
                     && request.auth.uid == resource.data.assignedTo
                     && !isTerminal()
                     && request.resource.data.diff(resource.data).changedKeys().hasOnly(["status","completedAt"]) 
                     && (!("status" in request.resource.data) || request.resource.data.status != "completed" || subsAllCompletedForNewDoc())
                     && statusChangeLocked()
                     && (!("status" in request.resource.data) || isAllowedStatus(request.resource.data.status));

      // Unassigned public task (assignedTo == null): any approved user in the same company can COMPLETE it
      // Constraints: not terminal, only change status/completedAt, status must be "completed", all subTasks must be completed
      allow update: if request.auth != null
                     && isApproved()
                     && resource.data.type == "public"
                     && resource.data.companyId == userCompanyId()
                     && resource.data.assignedTo == null
                     && !isTerminal()
                     && request.resource.data.diff(resource.data).changedKeys().hasOnly(["status","completedAt"]) 
                     && ("status" in request.resource.data)
                     && request.resource.data.status == "completed"
                     && subsAllCompletedForNewDoc()
                     && statusChangeLocked();
      allow delete: if request.auth != null
                     && resource.data.type == "public"
                     && isAdmin()
                     && resource.data.status != "progress"
                     && !hasProgressSubtask();
    }
  }
}


// firebase deploy --only firestore:rules
// firebase deploy --only functions
// Function URL (ping, us-central1): https://ping-x3tfsbgsra-uc.a.run.app
// Function URL (markMissedNow, us-central1): https://markmissednow-x3tfsbgsra-uc.a.run.app
